E "//Объявление событий панели
#event LampTurnedOn()
#event LampTurnedOff()

//Объявление свойств панели
#property bool DisplayShadows
#property bool DisplayLampStand

//Переменные свойств панели
private bool m_DisplayShadows = false;
private bool m_DisplayLampStand = false;

//Константы панели
private string LAMP_GLASS = \"LAMP_GLASS\";
private string LAMP_BRACING = \"LAMP_BRACING\";
private string LAMP_ON_COLOR = \"Yellow\";
private string LAMP_OFF_COLOR = \"darkgrey\";
private string SHADOW_COLOR = \"NotificationBar_AnotherUser\";
private int SHADOW_RADIUS = 150;

class Lamp{
  //Костанта для класса Lamp
  private float LIGHT_LEVEL_THRESHOLD = 60.0;

  //Переменные для хранения состояний датапоинтов
  private bool lampStatus;
  private bool isListenSensor;
  private bool isLampSwitched;
  private float lightLevel;

  /*
    Входные данные: -
    Выходные данные: -

    Конструктор класса подписывается на изменения в датапоинтах
    и конфигурирует начальный внешний вид элементов панели.
  */
  public Lamp(){
    string dpLampStatus = \"System1:\"+$lampDpName+\".Inputs.Status\";
    string dpListenSensor = \"System1:\"+$lampDpName+\".Commands.ListenSensor\";
    string dpLampSwitch = \"System1:\"+$lampDpName+\".Commands.Switch\";
    string dpLightLevel = \"System1:\"+$lightSensorName+\".Inputs.LightLevel\";

    if(dpExists(dpListenSensor)) dpConnect(\"onListenSensorChanged\", dpListenSensor);
    if(dpExists(dpLampStatus)) dpConnect(\"onLampStatusChanged\", dpLampStatus);
    if(dpExists(dpLampSwitch)) dpConnect(\"onLampSwitched\", dpLampSwitch);
    if(dpExists(dpLightLevel)) dpConnect(\"onLightLevelChanged\", dpLightLevel);

    setValue(LAMP_BRACING, \"visible\", m_DisplayLampStand);
    setValue(LAMP_GLASS, \"shadowEnabled\", (m_DisplayShadows && this.lampStatus),
             \"shadowColor\", SHADOW_COLOR,
             \"shadowOffset\", 0, 0,
             \"shadowRadius\", SHADOW_RADIUS);
  }

  /*
    Входные данные:
      string dp - ссылка на датапоинт
      bool newLampStatus - новое состояние статуса лампочки
    Выходные данные: -

    Метод фиксирует новое состояние лампочки в переменную lampStatus
    и вызывает методы включение или выключения лампочки в зависимости
    от ее нового состояния.
  */
  public void onLampStatusChanged(string dp, bool newLampStatus){
    this.lampStatus = newLampStatus;
    if(newLampStatus){
      this.turnOnLamp();
    } else {
      this.turnOffLamp();
    }
  }

  /*
    Входные данные:
      string dp - ссылка на датапоинт
      bool newIsListenSensor - новое состояние команды прослушки датчика
    Выходные данные: -

    Метод фиксирует новое состояние команды прослушки дачика в переменную
    isListenSensor.
  */
  public void onListenSensorChanged(string dp, bool newIsListenSensor){
    this.isListenSensor = newIsListenSensor;
  }

  /*
    Входные данные:
      string dp - ссылка на датапоинт
      bool newIsLampSwitched - новое состояние команды включения лампочки
    Выходные данные: -

    Метод фиксирует новое состояние команды включения лампочки в переменную
    isLampSwitched.
  */
  public void onLampSwitched(string dp, bool newIsLampSwitched){
    this.isLampSwitched = newIsLampSwitched;
  }

  /*
    Входные данные:
      string dp - ссылка на датапоинт
      bool newLightLevel - новое значение уровня освещенности
    Выходные данные: -

    Метод фиксирует новое значение уровня освещенности в переменную
    lightLevel.
  */
  public void onLightLevelChanged(string dp, float newLightLevel){
    this.lightLevel = newLightLevel;
  }

  /*
    Входные данные: -
    Выходные данные: -

    Метод меняет внешний вид элементов панели для отображения включенной
    лампочки.
  */
  private void turnOnLamp(){
    setValue(LAMP_GLASS, \"color\", LAMP_ON_COLOR,
             \"shadowEnabled\", (m_DisplayShadows && this.lampStatus));

    triggerEvent(\"LampTurnedOn\");
  }

  /*
    Входные данные: -
    Выходные данные: -

    Метод меняет внешний вид элементов панели для отображения выключенной
    лампочки.
  */
  private void turnOffLamp(){
    setValue(LAMP_GLASS, \"color\", LAMP_OFF_COLOR,
             \"shadowEnabled\", (m_DisplayShadows && this.lampStatus));

    triggerEvent(\"LampTurnedOff\");
  }

  /*
    Входные данные: -
    Выходные данные: -

    Метод устанавливает новое состояние лампочки в зависимоти от зачений
    комнды прослушки датчика, команды включения лампочки и уровня освещенности.
  */
  public void checkLampCondition(){
    string dpLampStatus = \"System1:\"+$lampDpName+\".Inputs.Status\";

    bool newLampStatus;
    if(this.isListenSensor){
      if(this.lightLevel < this.LIGHT_LEVEL_THRESHOLD){
        newLampStatus = true;
      } else {
        newLampStatus = false;
      }
    } else {
      newLampStatus = this.isLampSwitched;
    }

    if(this.lampStatus != newLampStatus){
      dpSet(dpLampStatus, newLampStatus);
    }
  }
};

/*
  Входные данные: -
  Выходные данные: Состояние свойства отображения тени лампочки

  Метод вовращает состояние свойства отображения тени лампочки.
*/
public bool getDisplayShadows() {
  return m_DisplayShadows;
}

/*
  Входные данные: Новое состояние свойства отображения тени лампочки
  Выходные данные: -

  Метод устанавливает новое состояние свойства отображения тени лампочки.
*/
public void setDisplayShadows(bool value) {
  m_DisplayShadows = value;
}


/*
  Входные данные: -
  Выходные данные: Состояние свойства отображения крепления ламочки

  Метод вовращает состояние свойства отображения крепления ламочки.
*/
public bool getDisplayLampStand() {
  return m_DisplayLampStand;
}

/*
  Входные данные: Новое состояние свойства отображения крепления ламочки
  Выходные данные: -

  Метод устанавливает новое состояние свойства отображения крепления ламочки.
*/
public void setDisplayLampStand(bool value) {
  m_DisplayLampStand = value;
  setValue(LAMP_BRACING, \"visible\", value);
}

//Объявление глобальной переменной лампочки
