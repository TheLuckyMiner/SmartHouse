""0  1
E "class SwitchBtn{
  //Инициализация константных значений
  private dyn_string TURN_ON_PLANES = makeDynString(\"Switch1_1\", \"Switch1_2\", \"Switch1_3\");
  private dyn_string TURN_OFF_PLANES = makeDynString(\"Switch2_1\", \"Switch2_2\", \"Switch2_3\");
  private string DP_SWITCH = \"System1:\"+$switchItem+\".Commands.Switch\";

  /*
    Входные значения: -
    Выходные значения: -

    Метод подключает прослушку команды включения лампочки
  */
  public void connectSwitches(){
    if(dpExists(this.DP_SWITCH)){
      dpConnect(\"setCondition\", this.DP_SWITCH);
    }
  }

  /*
    Входные данные:
      string dp - ссылка на датапоинт
      bool isTurnOn - новое состояние команды включения лампочки
    Выходные данные: -

    Метод меняет внешний вид переключателя для отображения включенного
    или выключенного состояний.
  */
  private void setCondition(string dp, bool isTurnOn){
    dyn_string planesToShow;
    dyn_string planesToHide;

    if(isTurnOn){
      planesToShow = this.TURN_ON_PLANES;
      planesToHide = this.TURN_OFF_PLANES;
    } else {
      planesToShow = this.TURN_OFF_PLANES;
      planesToHide = this.TURN_ON_PLANES;
    }
    for(int planeIndex = 1; planeIndex<=dynlen(planesToShow); planeIndex++){
      setValue(planesToShow[planeIndex], \"visible\", TRUE);
    }

    for(int planeIndex = 1; planeIndex<=dynlen(planesToHide); planeIndex++){
      setValue(planesToHide[planeIndex], \"visible\", FALSE);
    }
  }

  /*
    Входные данные: -
    Выходные данные: -

    Метод меняет значение команды включения лампочки на TRUE.
  */
  public void turnOn(){
    if(dpExists(this.DP_SWITCH)){
      dpSet(this.DP_SWITCH, TRUE);
    }
  }

  /*
    Входные данные: -
    Выходные данные: -

    Метод меняет значение команды включения лампочки на FALSE.
  */
  public void turnOff(){
    if(dpExists(this.DP_SWITCH)){
      dpSet(this.DP_SWITCH, FALSE);
    }
  }
};

//Объявление глобальной переменной переключателя.
public SwitchBtn switchBtn;" 0
