E "//Инициализация константных значений
public string DP_IS_LEAK = \"System1:\"+$leakSensorName+\".Inputs.IsLeak\";
public string DP_LEAK_ALARM = \"System1:\"+$leakSensorName+\".Alarms.LeakAlarm\";

class LeakSensor{

  /*
    Входные данные: -
    Выходные данные: -

    Конструктор подписывается на изменения датчика протечки.
  */
  public LeakSensor(){
    if(dpExists(DP_IS_LEAK)){
      dpConnect(\"connectLeakSensor\", DP_IS_LEAK);
    }
  }

  /*
    Входные данные:
      string dp - ссылка на датапоинт
      bool newIsLeak - новое состояние параметра протечки
    Выходные данные: -

    Метод меняет состояние предупреждения о протечке.
  */
  private connectLeakSensor(string dp, bool newIsLeak){
    dpSet(DP_LEAK_ALARM, newIsLeak);
  }
};

//Объявление глобальной переменной датчика протечки
