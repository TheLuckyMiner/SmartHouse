"main()
{
  EP_setBackColor();
}

/*
  Входные данные: -
  Выходные данные: -

  Метод подписывается на изменеие цвета предупреждения о протечке.
*/
void EP_setBackColor()
{
  dyn_errClass err;

  if( !dpExists( \"System1:\"+$leakSensorName+\".Alarms.LeakAlarm:_alert_hdl.._act_state_color\"))
  {
    setValue(\"\", \"color\", \"_dpdoesnotexist\");
    return;
  }

  DebugN(\"test\", \"System1:\"+$leakSensorName+\".Alarms.LeakAlarm:_alert_hdl.._act_state_color\");
  dpConnect(\"EP_setBackColorCB\",
            \"System1:\"+$leakSensorName+\".Alarms.LeakAlarm:_alert_hdl.._act_state_color\");
  err = getLastError();
  if (dynlen(err) > 0)
    setValue(\"\", \"color\", \"_dpdoesnotexist\");

}

/*
  Входные данные: -
  Выходные данные: -

  Метод метод меняет цвет элементу при возникновении протечки.
*/
void EP_setBackColorCB(string dpSource, string sNewColor)
{
  setValue(\"\", \"backCol\", sNewColor);
}
