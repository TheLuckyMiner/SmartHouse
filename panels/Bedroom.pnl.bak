0 "toggled" "(bool on)"
"  //Инициализация константных значений
  string DP_BR1_LISTEN_SENSOR = \"System1:BedroomLamp1.Commands.ListenSensor\";
  string DP_BR2_LISTEN_SENSOR = \"System1:BedroomLamp2.Commands.ListenSensor\";
  string DP_BR3_LISTEN_SENSOR = \"System1:BedroomLamp3.Commands.ListenSensor\";

  //Присвоение новых значений прослушки датчика освещенности
  dpSet(DP_BR1_LISTEN_SENSOR, on,
        DP_BR2_LISTEN_SENSOR, on,
        DP_BR3_LISTEN_SENSOR, on);"
