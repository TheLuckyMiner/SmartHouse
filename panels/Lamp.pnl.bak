"// SimpleCtrlScriptStart {invalid}
main()
{
  EP_setBackColor();
}

void EP_setBackColor()
{
  dyn_errClass err;

  if( !dpExists( \"System1:\" + $dp + \".Inputs.Status:_online.._value\"))
  {
    setValue(\"\", \"color\", \"_dpdoesnotexist\");
    return;
  }

  dpConnect(\"EP_setBackColorCB\",
            \"System1:\" + $dp + \".Inputs.Status:_online.._value\");
  err = getLastError();
  if (dynlen(err) > 0)
    setValue(\"\", \"color\", \"_dpdoesnotexist\");

}

void EP_setBackColorCB(string dpSource, bool boNewValue)
{
  if (!boNewValue){
    setValue(\"\", \"backCol\", \"darkgrey\");
    setValue(\"\", \"shadowEnabled\", FALSE);
    setValue(\"\", \"shadowColor\", \"NotificationBar_AnotherUser\");
    setValue(\"\", \"shadowRadius\", 150);
    setValue(\"\", \"shadowOffset\", 0, 0);
  }
  else{
    setValue(\"\", \"backCol\", \"Yellow\");
  }
}

